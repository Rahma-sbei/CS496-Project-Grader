# Copy this file to .env and fill in your own key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Judge model (locked with judge_prompt_v3 — changing it requires re-running validate-judge)
GROQ_MODEL=openai/gpt-oss-120b

# System-under-test model (different family from the judge to avoid self-preference bias)
GROQ_MODEL_SYS=qwen/qwen3.8-27b
